# Platform
CONFIG_MACH_XIAOMI_CLOVER=y

# Audio
CONFIG_SND_SOC_TAS2557_STEREO=y
CONFIG_TAS2557_CODEC_STEREO=y
CONFIG_TAS2557_MISC_STEREO=y
CONFIG_TAS2557_REGMAP_STEREO=y

# Backlight
CONFIG_BACKLIGHT_LP855X=y

# Fingerprint
CONFIG_FPC_FINGERPRINT_CLOVER=y

# Touchscreen
CONFIG_TOUCHSCREEN_FOCALTECH_D9_D9P=y
CONFIG_TOUCHSCREEN_FTS_D9_D9P=y
CONFIG_TOUCHSCREEN_GT9XX_ZQL6019=y
CONFIG_TOUCHSCREEN_NT36xxx=y

# Hall
CONFIG_INPUT_HALL_SENSOR_E7S=y

# ---- Clover KS-SB Hybrid v0.1.0-baseline -----------------------------------
CONFIG_LOCALVERSION="-Clover-KS-SB-v0.1.1-susfs"
# Rationale (verified 2026-10-06 by RAM-boot A/B on the device): a ThinLTO+CFI
# build with the Debian clang 22.1.7 toolchain never reaches userspace on
# clover, while the same tree/config without LTO/CFI boots.  The bootable
# configuration is used for the baseline; LTO/CFI are revisited with a
# matching Android clang toolchain.
CONFIG_LTO_NONE=y
# CONFIG_LTO_CLANG is not set
# CONFIG_CFI_CLANG is not set
# CONFIG_CFI_CLANG_SHADOW is not set
# CONFIG_RELR is not set

# ---- Clover KS-SB Hybrid: features present in the pre-OTA custom ROM -------
# DroidSpaces (containers + DRM/vgem/vkms graphics) and KernelSU were part of
# the 0.17.x-based custom ROM but are absent from the stock LineageOS 24.0
# kernel.  Restored here so the Clover kernel is a superset of both.
CONFIG_SYSVIPC=y
CONFIG_SYSVIPC_COMPAT=y
CONFIG_SYSVIPC_SYSCTL=y
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_USER_NS=y
CONFIG_NET_NS=y
CONFIG_DMA_SHARED_BUFFER=y
CONFIG_DRM=y
CONFIG_DRM_VGEM=y
CONFIG_DRM_VKMS=y
CONFIG_SYNC_FILE=y
CONFIG_UDMABUF=y
CONFIG_DMABUF_HEAPS=y
CONFIG_DMABUF_HEAPS_SYSTEM=y
# KernelSU (ReSukiSU) manual-hook integration
CONFIG_KSU=y
CONFIG_KSU_FULL_NAME_FORMAT="%TAG_NAME%-%COMMIT_SHA%@%REPO_NAME%"
CONFIG_KSU_MULTI_MANAGER_SUPPORT=y
# CONFIG_KSU_MANUAL_HOOK is not set
CONFIG_KSU_SUSFS=y
CONFIG_KSU_SUSFS_SUS_PATH=y
CONFIG_KSU_SUSFS_SUS_MOUNT=y
CONFIG_KSU_SUSFS_SUS_KSTAT=y
CONFIG_KSU_SUSFS_SPOOF_UNAME=y
CONFIG_KSU_SUSFS_ENABLE_LOG=y
CONFIG_KSU_SUSFS_HIDE_KSU_SUSFS_SYMBOLS=y
CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG=y
CONFIG_KSU_SUSFS_OPEN_REDIRECT=y
# CONFIG_KSU_SUSFS_SUS_MAP is not set
# Observability: debugfs is required for suspend_stats / wakeup_sources, which
# Phase 0/1 of the design uses to prove deep-sleep residency.
CONFIG_DEBUG_FS=y
CONFIG_DEBUG_KERNEL=y
# CONFIG_KALLSYMS_ALL is not set
# CONFIG_IKHEADERS is not set

# SUSFS v1.5.9 legacy NON-GKI features retained by the 4.19 implementation
CONFIG_KSU_SUSFS_HAS_MAGIC_MOUNT=y
CONFIG_KSU_SUSFS_AUTO_ADD_SUS_KSU_DEFAULT_MOUNT=y
CONFIG_KSU_SUSFS_AUTO_ADD_SUS_BIND_MOUNT=y
CONFIG_KSU_SUSFS_TRY_UMOUNT=y
CONFIG_KSU_SUSFS_AUTO_ADD_TRY_UMOUNT_FOR_BIND_MOUNT=y
