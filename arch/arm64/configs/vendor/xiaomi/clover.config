# Platform
CONFIG_MACH_XIAOMI_CLOVER=y

# Audio
CONFIG_SND_SOC_TAS2557_STEREO=y
CONFIG_TAS2557_CODEC_STEREO=y
CONFIG_TAS2557_MISC_STEREO=y
CONFIG_TAS2557_REGMAP_STEREO=y

# Backlight
CONFIG_BACKLIGHT_LP855X=y

# Fingerprint
CONFIG_FPC_FINGERPRINT_CLOVER=y

# Touchscreen
CONFIG_TOUCHSCREEN_FOCALTECH_D9_D9P=y
CONFIG_TOUCHSCREEN_FTS_D9_D9P=y
CONFIG_TOUCHSCREEN_GT9XX_ZQL6019=y
CONFIG_TOUCHSCREEN_NT36xxx=y

# Hall
CONFIG_INPUT_HALL_SENSOR_E7S=y

# ---------------------------------------------------------------------------
# Clover KS-SB Hybrid 4.19 - v0.1.0-baseline parity block
#
# Nothing here is a tuning change. Each entry either (a) restores something the
# currently running SouthWest-NG 0.17.3 firmware has (verified against that
# kernel's /proc/config.gz), so v0.1.0-baseline stays a valid A/B reference and
# does not regress root / DroidSpaces / power behaviour, or (b) removes a
# build-time hardening feature the reference firmware never had.
# ---------------------------------------------------------------------------

# Release identity - must show up in /proc/version after flashing.
CONFIG_LOCALVERSION="-Clover-KS-SB-v0.1.0-baseline"

# Tick rate: reference firmware runs HZ=300 (0.18.0's defconfig ships HZ=100).
CONFIG_HZ_300=y
# CONFIG_HZ_100 is not set

# Control Flow Integrity is pure runtime overhead on SDA660 and the reference
# firmware has none. ThinLTO is deliberately KEPT: besides the usual size win it
# is what keeps Image.gz inside the 18,538,496 byte kernel region of the stock
# boot image.
# CONFIG_CFI_CLANG is not set

# DroidSpaces (container + graphics) support
CONFIG_SYSVIPC=y
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_USER_NS=y
CONFIG_NET_NS=y
CONFIG_DMA_SHARED_BUFFER=y
CONFIG_DRM=y
CONFIG_DRM_VGEM=y
CONFIG_DRM_VKMS=y
CONFIG_SYNC_FILE=y
CONFIG_UDMABUF=y
CONFIG_DMABUF_HEAPS=y
CONFIG_DMABUF_HEAPS_SYSTEM=y

# ReSukiSU, manual-hook flavour (matches reference firmware exactly)
CONFIG_KSU=y
CONFIG_KSU_FULL_NAME_FORMAT="%TAG_NAME%-%COMMIT_SHA%@%REPO_NAME%"
CONFIG_KSU_MULTI_MANAGER_SUPPORT=y
CONFIG_KSU_MANUAL_HOOK=y
CONFIG_KSU_MANUAL_HOOK_AUTO_SETUID_HOOK=y
CONFIG_KSU_MANUAL_HOOK_AUTO_INITRC_HOOK=y
CONFIG_KSU_MANUAL_HOOK_AUTO_INPUT_HOOK=y

# ReSukiSU manual-hook integration requires either KALLSYMS_ALL or static
# symbol exports in selinuxfs.c; the reference firmware uses KALLSYMS_ALL.
CONFIG_DEBUG_KERNEL=y
CONFIG_KALLSYMS_ALL=y
