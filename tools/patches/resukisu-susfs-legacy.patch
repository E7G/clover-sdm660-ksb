diff --git a/kernel/tools/susfs_compat.mk b/kernel/tools/susfs_compat.mk
index a51f668f..ac3a1dc6 100644
--- a/kernel/tools/susfs_compat.mk
+++ b/kernel/tools/susfs_compat.mk
@@ -6,3 +6,11 @@ ifeq ($(shell grep -q "ksu_selinux_hide_running" $(srctree)/security/selinux/hoo
 $(info -- $(REPO_NAME)/susfs_feature_check: selinux_hide manual hook found)
 ccflags-y += -DKSU_COMPAT_HAS_SUSFS_FEATURE_SELINUX_HIDE
 endif
+
+# Clover/non-GKI 4.19: SUSFS v1.5.x uses the legacy prctl ABI.
+# Keep ReSukiSU's modern reboot/supercall path out of this build; the kernel
+# tree provides a compatibility bridge for the v1.5.x userspace binary.
+ifeq ($(shell grep -qE '^#define SUSFS_VERSION "v1\.5\.' $(srctree)/include/linux/susfs.h; echo $$?),0)
+$(info -- $(REPO_NAME)/susfs_feature_check: legacy SUSFS v1.5.x prctl ABI)
+ccflags-y += -DKSU_COMPAT_SUSFS_LEGACY_PRCTL
+endif
